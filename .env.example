# Base de données (SQLite en local, remplacer par Postgres en prod)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="changez-moi-en-une-longue-chaine-aleatoire"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (génération des histoires)
ANTHROPIC_API_KEY="sk-ant-..."

# ElevenLabs (narration audio, fonctionnalité Pro — optionnel)
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM" # voix multilingue par défaut

# Stockage des fichiers audio — optionnel, en local par défaut (storage/audio/).
# Définir S3_BUCKET pour basculer automatiquement sur un stockage objet compatible
# S3 (AWS S3, Cloudflare R2, MinIO...) — nécessaire dès qu'on déploie sur une
# plateforme au filesystem éphémère (Vercel, etc.).
# S3_BUCKET="calin-histoires-audio"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com" # laisser vide pour AWS S3
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..." # ID du prix récurrent mensuel "Pro" (6,99€/mois)

NEXT_PUBLIC_APP_URL="http://localhost:3000"
